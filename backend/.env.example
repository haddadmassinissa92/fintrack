# Configuration de l'environnement FinTrack - Backend

# Port d'écoute du serveur
PORT=5002

# Environnement (development ou production)
NODE_ENV=development

# URL de l'application frontend (pour la configuration CORS)
CLIENT_URL=http://localhost:3000

# Chaîne de connexion MongoDB Atlas (SRV) ou locale
MONGO_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Clé secrète JWT (générer une chaîne aléatoire longue et sécurisée)
JWT_SECRET=votre_cle_jwt_secrete_aleatoire_et_tres_longue

# --- Brevo (Emails transactionnels : réinitialisation mot de passe, alertes budget, récapitulatifs mensuels) ---
# Clé API Brevo (v3 HTTPS)
BREVO_API_KEY=xkeysib-votre_cle_api_brevo
# Adresse email d'expéditeur validée dans votre compte Brevo
EMAIL_USER=contact@fintrack.app

# --- Web-Push (Notifications push navigateur) ---
# Clés VAPID générées (ex: via la commande `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=votre_cle_publique_vapid
VAPID_PRIVATE_KEY=votre_cle_privee_vapid
